# Example backend config for `multi_radio_server` / `multi_radio_radio`

# Default single-host runtime
MR_BIND_ADDRESS=0.0.0.0:50051
MR_AUTH_TOKEN=multi-radio-dev-token
MR_PLUGIN_DIR=./backend/plugins
MR_LOG_DIR=./logs
MR_POSITION_BIND_ADDRESS=
MR_POSITION_AUTH_TOKEN=

# Thin/thick split settings
MR_BACKEND_MODE=local
MR_REMOTE_DSP_HOST=
MR_IQ_TRANSPORT=grpc_stream

# ------------------------------------------------------------------
# Split runtime notes
# ------------------------------------------------------------------
# Thin/radio host:
#   MR_BACKEND_MODE=local
#   MR_PLUGIN_DIR=
#
# Thick/DSP host:
#   MR_BACKEND_MODE=remote
#   MR_REMOTE_DSP_HOST=<thin-host>:50051
#   MR_PLUGIN_DIR=./backend/plugins

# To build only the thin backend target:
#   cmake -S . -B build -DMR_BUILD_SERVER=OFF -DMR_BUILD_RADIO=ON -DMR_BUILD_FRONTEND=OFF -DMR_BUILD_TUI=OFF -DMR_BUILD_TESTS=OFF
#   cmake --build build --target multi_radio_radio
#
# Then run it with this config file:
#   MR_BACKEND_CONFIG=/path/to/backend.ini ./build/backend/multi_radio_radio
